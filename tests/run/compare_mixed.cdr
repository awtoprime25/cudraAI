inf = 1e308 * 10
nan = inf - inf
print(nan == nan, nan != nan, nan < 1, nan >= 1, 1 < nan, 1 == nan, 1 != nan)
print(2 ** 53 + 1 == 9007199254740992.0, 2 ** 53 + 1 > 9007199254740992.0)
print(9223372036854775807 < 9.223372036854776e18, 9223372036854775807 == 9.223372036854776e18)
print(-9223372036854775808 == -9.223372036854776e18, -9223372036854775808 < -0.0, 9223372036854775807 < inf)
print(0 == -0.0, 1 < 1.5 < 2 < 2.5, 9223372036854775807 > -inf)
print(1.5 > 1, 1.5 >= 9223372036854775807, 1.5 < -9223372036854775808)
