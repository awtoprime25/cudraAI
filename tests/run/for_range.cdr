for i in range(5):
    print(i)
for i in range(2, 5):
    print(i)
for i in range(0, 10, 3):
    print(i)
for i in range(10, 0, -3):
    print(i)
for i in range(5, 5):
    print(i)
for i in range(5, 0):
    print(i)
for i in range(0, 5, -1):
    print(i)
total = 0
for i in range(1000):
    total += i
print(total)
