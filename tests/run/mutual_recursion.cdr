def even(n: int) -> bool:
    if n == 0:
        return True
    return odd(n - 1)

def odd(n: int) -> bool:
    if n == 0:
        return False
    return even(n - 1)

print(even(10), odd(7), even(7), odd(0))
def f(a: int, b: float, c: bool) -> float:
    if c:
        return a * b
    return b - a
print(f(3, 0.5, True), f(3, 0.5, False))
