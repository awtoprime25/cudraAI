print(1 // 0.1, 1 % 0.1, -4.0 % 2.0, 4.0 % -2.0, -0.0 // 1.0, 0.0 // -1.0, -7 // 2.0)
inf = 1e308 * 10
print(inf // 1, inf % 1, 1 % inf, -1 % inf, -1 // inf)
print(1e308 // 1e-308, -1e-300 // 1e300)
a = -7.5
while a <= 7.5:
    b = -2.5
    while b <= 2.5:
        if b != 0.0:
            print(a, b, a // b, a % b, a / b)
        b += 1.25
    a += 1.5
