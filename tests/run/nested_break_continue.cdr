for i in range(1, 6):
    for j in range(1, 6):
        if j == 3:
            break
        if i == 4:
            continue
        print(i, j)
    if i == 5:
        break
total = 0
for i in range(10):
    if i % 3 == 0:
        continue
    for j in range(10):
        if j > i:
            break
        total += 1
print(total)
